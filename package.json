{
  "name": "flowguard-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "phase:validate": "node --test test/*.test.ts",
    "demo": "node src/demo/demo-company.ts",
    "dev": "node --env-file=.env src/server/server.ts",
    "start": "node --env-file=.env src/server/server.ts",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "phase9:validate": "npm test && npm run lint && npm run typecheck && npm run build && npm run demo"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
